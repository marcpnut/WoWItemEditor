<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyTitle>WoWItemEditor</AssemblyTitle><Product>WoWItemEditor</Product><Version>0.1.0</Version>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/WoWItemEditor.Verification/**/*.cs" Link="Verification/%(Filename)%(Extension)" />
    <None Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/**/*" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="DBCD" Version="2.3.1" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="TACTSharp" Version="0.2.0-alpha" />
  </ItemGroup>
</Project>
