<Window x:Class="AnoWowItemEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AnoWoW · Item Editor" Width="1440" Height="900" MinWidth="1100" MinHeight="680" Background="#232428" Foreground="#DBDEE1" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid Background="#232428"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1E1F22" BorderBrush="#36383F" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="25,30,16,28"><TextBlock Text="ANOWOW" FontSize="24" FontWeight="Bold" Foreground="#70B8FF"/><TextBlock Text="ITEM EDITOR" FontSize="11" Foreground="#9299A5" Margin="1,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="25,20"><TextBlock Text="BROWSE YOUR WORLD" FontSize="10" Foreground="#787F8C"/><TextBlock Text="Catalog workspace · v0.1" FontSize="11" Foreground="#9299A5" Margin="0,6,0,0"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="CHARACTERS" Foreground="#787F8C" FontSize="10" Margin="26,4,0,12"/>
    <RadioButton x:Name="CharacterNav" Content="Characters" GroupName="Navigation" Checked="Navigate"/>
    <Border Height="1" Background="#36383F" Margin="26,20,26,20"/>
    <TextBlock Text="CATALOGS" Foreground="#787F8C" FontSize="10" Margin="26,0,0,12"/>
    <RadioButton x:Name="ItemNav" Content="Item catalog" GroupName="Navigation" IsChecked="True" Checked="Navigate"/>
    <RadioButton Content="Spell catalog" GroupName="Navigation" Checked="Navigate"/>
    <RadioButton Content="Proc catalog" GroupName="Navigation" Checked="Navigate"/>
    <Border Height="1" Background="#36383F" Margin="26,14,26,14"/>
    <TextBlock Text="EDITORS" Foreground="#787F8C" FontSize="10" Margin="26,0,0,8"/>
    <Button Content="Set creator" Click="OpenSetCreator" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Modify created sets" Click="OpenCreatedSets" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Set preview &amp; balance" Click="OpenSetAnalysis" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Gear designer" Click="OpenDesigner" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Items" Click="OpenItemEditor" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Set bonuses" Click="OpenSetEditor" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Button Content="Weapon procs" Click="OpenWeaponEditor" Margin="10,3" HorizontalContentAlignment="Left"/>
    <Border Height="1" Background="#36383F" Margin="26,20,26,20"/>
    <TextBlock Text="HISTORY" Foreground="#787F8C" FontSize="10" Margin="26,0,0,12"/>
    <RadioButton x:Name="HistoryNav" Content="Change history" GroupName="Navigation" Checked="Navigate"/>
    <Button Content="Item, set &amp; proc edits" Click="OpenContentHistory" Margin="10,3"/>
   </StackPanel></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,25,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel Margin="0,0,180,0"><TextBlock x:Name="PageTitle" Text="Item catalog" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" TextWrapping="Wrap" Text="Explore your server’s items. Select a row to inspect its details." Foreground="#9299A5" Margin="0,6,0,0"/></StackPanel><Button x:Name="Reload" Content="↻   Refresh items" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshClick"/></Grid>
   <Grid x:Name="CatalogPage" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#2B2D31" CornerRadius="7" Padding="17" Margin="0,0,0,18"><StackPanel>
     <WrapPanel x:Name="CharacterControls" Visibility="Collapsed" Margin="0,0,0,14"><StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="Find character" Margin="0,0,0,6" Foreground="#9299A5"/><TextBox x:Name="CharacterSearch" TextChanged="CharacterSearchChanged"/></StackPanel><StackPanel Width="290" Margin="0,0,12,0"><TextBlock Text="Character" Margin="0,0,0,6" Foreground="#9299A5"/><ComboBox x:Name="CharacterPicker" SelectionChanged="CharacterChanged"/></StackPanel><StackPanel Width="180"><TextBlock Text="Storage" Margin="0,0,0,6" Foreground="#9299A5"/><ComboBox x:Name="StorageFilter" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="All owned items"/><ComboBoxItem Content="Equipped"/><ComboBoxItem Content="Bags &amp; bank"/><ComboBoxItem Content="Mail"/><ComboBoxItem Content="Void storage"/></ComboBox></StackPanel></WrapPanel>
     <DockPanel Margin="0,0,0,6"><TextBlock Text="Preview level" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#9299A5"/><TextBox x:Name="PreviewLevel" Text="60" Width="58" HorizontalAlignment="Left" TextChanged="PreviewLevelChanged" KeyDown="PreviewLevelKeyDown" ToolTip="Enter a level, then click Apply level. Preview only."/><Button x:Name="ApplyLevelButton" Content="Apply level" Margin="8,0,0,0" Padding="12,5" BorderBrush="#70B8FF" Click="ApplyPreviewLevel"/><Button Content="Reset" Margin="8,0,0,0" Padding="10,5" Click="ResetPreviewLevel"/><TextBlock x:Name="CharacterSummary" Text="Preview only · no character or item changes are saved" VerticalAlignment="Center" Foreground="#9299A5" FontSize="11" Margin="14,0,0,0" TextWrapping="Wrap"/></DockPanel>
     <TextBlock x:Name="LevelFeedback" Text="Applied level 60 · preview only" Foreground="#70B8FF" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SEARCH ITEMS" FontSize="10" Foreground="#9299A5" Margin="0,0,0,6"/><TextBox x:Name="Search" ToolTip="Search item name or exact item ID" TextChanged="FilterChanged"/></StackPanel><Button Content="Clear filters" Grid.Column="1" Margin="14,18,0,0" Click="ClearClick"/></Grid>
     <Expander x:Name="AdvancedFilters" Header="Filters · rarity, slot, type, level and equipment set" IsExpanded="True" Foreground="#9299A5" Margin="0,12,0,0"><StackPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Rarity" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="Rarity" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Equipment slot" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="Slot" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Item type" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="ItemType" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="6"><TextBlock Text="Subtype · armor material" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="ItemSubtype" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="8"><TextBlock Text="Required level" Foreground="#9299A5" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="MinLevel" ToolTip="Minimum required level" TextChanged="FilterChanged"/><TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="MaxLevel" Grid.Column="2" ToolTip="Maximum required level" TextChanged="FilterChanged"/></Grid></StackPanel>
     </Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Equipment set" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="SetFilter" DisplayMemberPath="Label" TextSearch.TextPath="Label" SelectionChanged="FilterChanged" ToolTip="Choose a set, or type its name while focused to jump to it"/></StackPanel><TextBlock Grid.Column="1" Text="Tip: click a set name or piece in the tooltip." Foreground="#9299A5" FontSize="11" VerticalAlignment="Bottom" Margin="16,0,0,10"/></Grid><TextBlock x:Name="FilterError" Foreground="#FF8C82" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Expander>
    </StackPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="390" MinWidth="290"/></Grid.ColumnDefinitions>
     <Border Background="#282A2F" CornerRadius="7" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ResultCount" Text="Loading items…" Foreground="#9299A5" Margin="16,13"/>
      <DataGrid x:Name="ItemsGrid" Grid.Row="1" SelectionChanged="SelectItem" MouseDoubleClick="EditItemDoubleClick" ToolTip="Double-click an item to edit its definition"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Item name" SortMemberPath="Name" Width="*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn x:Name="LocationColumn" Header="Location" Binding="{Binding Location}" Width="150" Visibility="Collapsed"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A7ADB8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn x:Name="CountColumn" Header="Qty" Binding="{Binding Count}" Width="48" Visibility="Collapsed"/>
       <DataGridTextColumn Header="Subtype" Binding="{Binding SubtypeName}" Width="90"/>
       <DataGridTextColumn Header="Req. level" Binding="{Binding RequiredLevel}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DBDEE1"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="Item ID" Binding="{Binding Id}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A7ADB8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns></DataGrid>
      <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="No items match these filters." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9299A5" Visibility="Collapsed"/>
     </Grid></Border>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#36383F" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
     <Border Grid.Column="2" Background="#2B2D31" CornerRadius="7" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ITEM PREVIEW" FontSize="10" Foreground="#9299A5" Margin="0,0,0,17"/><TextBlock x:Name="PreviewLegend" DockPanel.Dock="Bottom" Text="Calculations use server tables. [scales] = unresolved rule. [client value] = unavailable client value. No character equipped." Foreground="#787F8C" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/><ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#10111B" BorderBrush="#616781" BorderThickness="1" CornerRadius="6" Padding="18"><StackPanel x:Name="TooltipPanel"><TextBlock Text="Select an item" FontSize="18" Foreground="#70B8FF"/><TextBlock Text="Its tooltip will appear here." Foreground="#9299A5" Margin="0,9,0,0"/></StackPanel></Border><TextBlock x:Name="SourceLabel" Foreground="#9299A5" FontSize="11" Margin="2,13,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></DockPanel></Border>
    </Grid>
   </Grid>
   <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed"><Grid.Resources><Style x:Key="HistoryText" TargetType="TextBlock"><Setter Property="Foreground" Value="#DBDEE1"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#2B2D31" CornerRadius="7" Padding="16" Margin="0,0,0,16"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="210"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0"><TextBlock Text="Search item name, ID or changed field" Foreground="#9299A5" Margin="0,0,0,6"/><TextBox x:Name="HistorySearch" TextChanged="HistoryFilterChanged"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="State" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="HistoryState" SelectedIndex="1" SelectionChanged="HistoryFilterChanged"><ComboBoxItem Content="All"/><ComboBoxItem Content="Active"/><ComboBoxItem Content="Inactive"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Recorded activity" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="HistoryActivity" SelectedIndex="0" SelectionChanged="HistoryFilterChanged"><ComboBoxItem Content="All database records"/><ComboBoxItem Content="Has recorded app activity"/><ComboBoxItem Content="No recorded app activity"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="Preview level (both items)" Foreground="#9299A5" Margin="0,0,0,6"/><DockPanel><Button Content="Apply level" DockPanel.Dock="Right" Click="ApplyHistoryLevel" Margin="8,0,0,0" Padding="10,6"/><TextBox x:Name="HistoryLevel" Text="60"/></DockPanel></StackPanel>
     </Grid>
     <Expander Header="Item filters · rarity, slot, type, required level and equipment set" Foreground="#9299A5" Margin="0,12,0,0"><StackPanel>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="Rarity" Margin="0,0,0,6"/><ComboBox x:Name="HistoryRarity" DisplayMemberPath="Label" SelectionChanged="HistoryFilterChanged"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Equipment slot" Margin="0,0,0,6"/><ComboBox x:Name="HistorySlot" DisplayMemberPath="Label" SelectionChanged="HistoryFilterChanged"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Item type" Margin="0,0,0,6"/><ComboBox x:Name="HistoryType" DisplayMemberPath="Label" SelectionChanged="HistoryFilterChanged"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Subtype · armor material" Margin="0,0,0,6"/><ComboBox x:Name="HistorySubtype" DisplayMemberPath="Label" SelectionChanged="HistoryFilterChanged"/></StackPanel>
       <StackPanel Grid.Column="4"><TextBlock Text="Required level" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="HistoryMinLevel" TextChanged="HistoryFilterChanged" ToolTip="Minimum required level"/><TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="HistoryMaxLevel" Grid.Column="2" TextChanged="HistoryFilterChanged" ToolTip="Maximum required level"/></Grid></StackPanel>
      </Grid><DockPanel Margin="0,12,0,0"><Button Content="Clear item filters" DockPanel.Dock="Right" Click="ClearHistoryFilters" Margin="12,0,0,0"/><ComboBox x:Name="HistorySet" DisplayMemberPath="Label" TextSearch.TextPath="Label" SelectionChanged="HistoryFilterChanged" ToolTip="Equipment set"/></DockPanel>
     </StackPanel></Expander>
     <DockPanel Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="RemoveHistoryButton" Content="Remove from history" Click="RemoveHistory" IsEnabled="False" Margin="8,0,0,0"/><Button x:Name="RevertButton" Content="Revert…" Click="ReviewRevert" IsEnabled="False" Margin="8,0,0,0"/><Button x:Name="ReapplyButton" Content="Reapply…" Click="ReviewReapply" IsEnabled="False" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="HistoryCount" Text="Loading override records…" Foreground="#9299A5" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
     <CheckBox x:Name="ShowRemovedHistory" Content="Show removed entries" Foreground="#9299A5" Margin="0,8,0,0" Checked="HistoryFilterChanged" Unchecked="HistoryFilterChanged"/>
    </StackPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.65*" MinWidth="480"/></Grid.ColumnDefinitions>
     <Border Background="#282A2F" CornerRadius="7"><DataGrid x:Name="HistoryGrid" IsSynchronizedWithCurrentItem="True" SelectionChanged="HistorySelectionChanged"><DataGrid.Columns>
      <DataGridTemplateColumn Header="Item" SortMemberPath="Name" Width="*" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="75" ElementStyle="{StaticResource HistoryText}"/>
      <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="80" ElementStyle="{StaticResource HistoryText}"/>
      <DataGridTextColumn Header="Build" Binding="{Binding Build}" Width="75" ElementStyle="{StaticResource HistoryText}"/>
     </DataGrid.Columns></DataGrid></Border>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#36383F" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="HistoryDetail" Text="Select an override to compare its original and modified values." Foreground="#9299A5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#2B2D31" CornerRadius="7" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ORIGINAL" Foreground="#70B8FF" FontSize="11" Margin="0,0,0,10"/><ScrollViewer x:Name="OriginalHistoryScroll" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="OriginalHistorySource" Foreground="#9299A5" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/><Border Background="#10111B" BorderBrush="#616781" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel x:Name="OriginalHistoryTooltip"/></Border></StackPanel></ScrollViewer></DockPanel></Border>
       <Border Grid.Column="2" Background="#2B2D31" CornerRadius="7" Padding="12"><DockPanel><TextBlock x:Name="ModifiedHistoryTitle" DockPanel.Dock="Top" Text="CURRENT" Foreground="#70B8FF" FontSize="11" Margin="0,0,0,10"/><ScrollViewer x:Name="ModifiedHistoryScroll" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ModifiedHistorySource" Foreground="#9299A5" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/><Border Background="#10111B" BorderBrush="#616781" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel x:Name="ModifiedHistoryTooltip"/></Border></StackPanel></ScrollViewer></DockPanel></Border>
      </Grid>
      <DockPanel Grid.Row="2" Margin="0,12,0,7"><CheckBox x:Name="ChangedFieldsOnly" Content="Changed fields only" IsChecked="True" Foreground="#DBDEE1" DockPanel.Dock="Right" Checked="HistorySelectionChanged" Unchecked="HistorySelectionChanged"/><TextBlock Text="FIELD DIFFERENCES" Foreground="#9299A5" FontSize="10"/></DockPanel>
      <DataGrid x:Name="HistoryFields" Grid.Row="3" RowHeight="28"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="1.1*" ElementStyle="{StaticResource HistoryText}"/><DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" ElementStyle="{StaticResource HistoryText}"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="*" ElementStyle="{StaticResource HistoryText}"/></DataGrid.Columns></DataGrid>
      <Expander Grid.Row="4" Header="Recorded app activity" Foreground="#9299A5" Margin="0,9,0,0"><TextBox x:Name="HistoryAudit" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="100"/></Expander>
     </Grid>
    </Grid>
   </Grid>
   <Border x:Name="Placeholder" Grid.Row="1" Background="#2B2D31" CornerRadius="7" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Coming in a later step" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="We’re starting with the Item catalog." Foreground="#9299A5" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
   <Grid x:Name="ReferencePage" Grid.Row="1" Visibility="Collapsed"/>
   <TextBlock x:Name="Status" Grid.Row="2" Text="Connecting to MariaDB…" Foreground="#9299A5" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
