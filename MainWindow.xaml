<Window x:Class="AnoWowItemEditor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AnoWoW · Item Editor" Width="1440" Height="900" MinWidth="1100" MinHeight="680" Background="#232428" Foreground="#DBDEE1" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid Background="#232428"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1E1F22" BorderBrush="#36383F" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="25,30,16,28"><TextBlock Text="ANOWOW" FontSize="24" FontWeight="Bold" Foreground="#70B8FF"/><TextBlock Text="ITEM EDITOR" FontSize="11" Foreground="#9299A5" Margin="1,5,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="25,20"><TextBlock Text="BROWSE YOUR WORLD" FontSize="10" Foreground="#787F8C"/><TextBlock Text="Catalog workspace · v0.1" FontSize="11" Foreground="#9299A5" Margin="0,6,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="CATALOGS" Foreground="#787F8C" FontSize="10" Margin="26,4,0,12"/><RadioButton x:Name="ItemNav" Content="Item catalog" GroupName="Navigation" IsChecked="True" Checked="Navigate"/><RadioButton Content="Spell catalog" GroupName="Navigation" Checked="Navigate"/><RadioButton Content="Proc catalog" GroupName="Navigation" Checked="Navigate"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,25,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" Text="Item catalog" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Explore your server’s items. Select a row to inspect its details." Foreground="#9299A5" Margin="0,6,0,0"/></StackPanel><Button x:Name="Reload" Content="↻   Refresh items" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshClick"/></Grid>
   <Grid x:Name="CatalogPage" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#2B2D31" CornerRadius="7" Padding="17" Margin="0,0,0,18"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SEARCH ITEMS" FontSize="10" Foreground="#9299A5" Margin="0,0,0,6"/><TextBox x:Name="Search" ToolTip="Search item name or exact item ID" TextChanged="FilterChanged"/></StackPanel><Button Content="Clear filters" Grid.Column="1" Margin="14,18,0,0" Click="ClearClick"/></Grid>
     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Rarity" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="Rarity" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="Equipment slot" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="Slot" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="Item type" Foreground="#9299A5" Margin="0,0,0,6"/><ComboBox x:Name="ItemType" DisplayMemberPath="Label" SelectionChanged="FilterChanged"/></StackPanel>
      <StackPanel Grid.Column="6"><TextBlock Text="Required level" Foreground="#9299A5" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="MinLevel" ToolTip="Minimum required level" TextChanged="FilterChanged"/><TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBox x:Name="MaxLevel" Grid.Column="2" ToolTip="Maximum required level" TextChanged="FilterChanged"/></Grid></StackPanel>
     </Grid><TextBlock x:Name="FilterError" Foreground="#FF8C82" Visibility="Collapsed" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="390" MinWidth="290"/></Grid.ColumnDefinitions>
     <Border Background="#282A2F" CornerRadius="7" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ResultCount" Text="Loading items…" Foreground="#9299A5" Margin="16,13"/>
      <DataGrid x:Name="ItemsGrid" Grid.Row="1" SelectionChanged="SelectItem"><DataGrid.Columns>
       <DataGridTemplateColumn Header="Item name" SortMemberPath="Name" Width="*" MinWidth="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Req. level" Binding="{Binding RequiredLevel}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DBDEE1"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="Item ID" Binding="{Binding Id}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A7ADB8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns></DataGrid>
      <TextBlock x:Name="EmptyMessage" Grid.Row="1" Text="No items match these filters." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9299A5" Visibility="Collapsed"/>
     </Grid></Border>
     <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="#36383F" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
     <Border Grid.Column="2" Background="#2B2D31" CornerRadius="7" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="ITEM PREVIEW" FontSize="10" Foreground="#9299A5" Margin="0,0,0,17"/><TextBlock DockPanel.Dock="Bottom" Text="[scales] = calculated by the game. [client value] = client-derived value. Set bonuses are inactive: no character equipped." Foreground="#787F8C" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/><ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#10111B" BorderBrush="#616781" BorderThickness="1" CornerRadius="6" Padding="18"><StackPanel x:Name="TooltipPanel"><TextBlock Text="Select an item" FontSize="18" Foreground="#70B8FF"/><TextBlock Text="Its tooltip will appear here." Foreground="#9299A5" Margin="0,9,0,0"/></StackPanel></Border><TextBlock x:Name="SourceLabel" Foreground="#9299A5" FontSize="11" Margin="2,13,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></DockPanel></Border>
    </Grid>
   </Grid>
   <Border x:Name="Placeholder" Grid.Row="1" Background="#2B2D31" CornerRadius="7" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Coming in a later step" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="We’re starting with the Item catalog." Foreground="#9299A5" Margin="0,12,0,0" HorizontalAlignment="Center"/></StackPanel></Border>
   <TextBlock x:Name="Status" Grid.Row="2" Text="Connecting to MariaDB…" Foreground="#9299A5" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
